"""Generates og-image.png (1200x630) for SF cafes social sharing."""
from PIL import Image, ImageDraw, ImageFont

W, H = 1200, 630

BG = (235, 235, 229)
INK = (22, 28, 34)
INK2 = (82, 90, 98)
INK3 = (138, 144, 151)
ACCENT = (210, 74, 42)
ACCENT_DARK = (160, 56, 32)
RULE = (210, 210, 200)

img = Image.new("RGB", (W, H), BG)
d = ImageDraw.Draw(img)

# Subtle inner border
d.rectangle((24, 24, W - 24, H - 24), outline=RULE, width=2)

# Top-left kicker mono
kicker_font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf", 22)
d.text((72, 78), "SAN FRANCISCO · A CURATED COFFEE SHOP GUIDE", font=kicker_font, fill=INK3)

# Main wordmark "SF cafes" — sized to leave room for cup on right
title_font = ImageFont.truetype("/usr/share/fonts/opentype/urw-base35/P052-Bold.otf", 180)
d.text((68, 140), "SF cafes", font=title_font, fill=INK)

# Tagline italic
sub_font = ImageFont.truetype("/usr/share/fonts/opentype/urw-base35/P052-Italic.otf", 44)
d.text((72, 360), "Work-friendly coffee, mapped.", font=sub_font, fill=INK2)

# Stats line — small mono
stats_font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf", 22)
d.text((72, 430), "60 SPOTS & Counting  ·  THE BEST OF SF BY NEIGHBORHOOD",
       font=stats_font, fill=INK3)

# Bottom-left URL
url_font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf", 26)
d.text((72, H - 86), "thesflist.com", font=url_font, fill=ACCENT)

# ----- Coffee cup illustration on the right -----
# Placed clearly to the right of the title, not overlapping
cx, cy = 1000, 360
